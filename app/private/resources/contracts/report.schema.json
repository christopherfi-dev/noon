{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "architecture_version": {
      "const": "1.8"
    },
    "curriculum_version": {
      "const": "1.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "INTERRUPTED",
        "BOUNDARY_REACHED",
        "IN_PROGRESS"
      ]
    },
    "targets_attempted": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][0-9]{2}$"
      },
      "maxItems": 100
    },
    "independent_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 2000
          },
          "skill_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "component_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "review_scope": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "statement",
          "skill_id",
          "component_id",
          "event_ids",
          "review_scope"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "guided_work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 2000
