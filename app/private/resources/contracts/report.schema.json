        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "HYPOTHESIS",
              "INSTRUCTIONAL_TRIAL"
            ]
          },
          "statement": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "hypothesis_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "UNRESOLVED",
                  "PROVISIONAL",
                  "SUPPORTED_FOR_OBSERVED_PATTERN",
                  "CONTRADICTED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "statement",
          "evidence_event_ids",
          "hypothesis_status"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "unresolved_or_untested": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "next_evidence_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "policy_note": {
      "type": "string",
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "report_id",
    "session_id",
    "state_revision",
    "architecture_version",
    "curriculum_version",
    "status",
    "targets_attempted",
    "independent_evidence",
    "guided_work",
    "repairs_and_returns",
    "immediate_criteria",
    "transfer_evidence",
    "retention_evidence",
    "hypotheses",
