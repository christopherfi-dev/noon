{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "architecture_version": {
      "const": "1.3"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "state_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reply_to_event_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "message_type": {
      "type": "string",
      "enum": [
        "CONTROL",
        "QUESTION",
        "FEEDBACK",
        "REPORT",
        "HOLD"
      ]
    },
    "student_message": {
      "type": "string",
      "maxLength": 3000
    },
    "item": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "enum": [
                "practice",
                "check",
                "retry"
              ]
            },
            "skill_id": {
              "type": "string",
              "pattern": "^[A-Z][0-9]{2}$"
            },
            "source": {
              "type": "string",
              "enum": [
                "recipe",
                "spec",
                "retry"
              ]
            },
            "recipe_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "spec": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "linear_equation",
                        "expand",
                        "signed_arithmetic",
                        "numeric_step"
                      ]
                    },
                    "expression": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "kind",
                    "expression"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "prompt": {
              "type": "string",
              "maxLength": 600
            },
            "stated_answer": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "purpose",
            "skill_id",
            "source",
            "recipe_ref",
            "spec",
            "prompt",
            "stated_answer"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_transition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "to_mode": {
              "type": "string",
              "enum": [
                "EXPLAIN",
                "ASK",
                "POSE_PROBLEM",
                "HINT",
                "SLIP_CHECK",
                "STEP_BACK",
                "MOVE_ON",
                "REVIEW",
                "WRAP_UP",
                "ANSWER_QUESTION",
                "CONTINUE"
              ]
            },
            "target_skill_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z][0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 500
            },
            "evidence_event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "maxItems": 100
            }
          },
          "required": [
            "to_mode",
            "target_skill_id",
            "reason",
            "evidence_event_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "HYPOTHESIS",
              "INSTRUCTIONAL_TRIAL"
            ]
          },
          "statement": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "hypothesis_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "UNRESOLVED",
                  "PROVISIONAL",
                  "SUPPORTED_FOR_OBSERVED_PATTERN",
                  "CONTRADICTED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "statement",
          "evidence_event_ids",
          "hypothesis_status"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "resource_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "purpose": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "skill_id",
          "purpose"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "teacher_report": {
      "type": "null"
    },
    "issue": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "MISSING_CURRICULUM",
                "MISSING_TARGET",
                "MISSING_STATE",
                "CURRICULUM_GAP",
                "UNSUPPORTED_RESPONSE_TYPE",
                "REPRESENTATION_UNAVAILABLE",
                "ITEM_VERIFICATION_UNAVAILABLE",
                "PROVIDER_UNAVAILABLE",
                "INVALID_ITEM",
                "VERIFICATION_CONFLICT",
                "STATE_CONFLICT",
                "EVIDENCE_PROMOTION_BLOCKED",
                "CONTRACT_CONFLICT",
                "REPAIR_LIMIT_REACHED"
              ]
            },
            "affected_scope": {
              "type": "string",
              "maxLength": 2000
            },
            "detail": {
              "type": "string",
              "maxLength": 2000
            },
            "next_action": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "affected_scope",
            "detail",
            "next_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reading": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "is_answer": {
              "type": "boolean"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "other_readings": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              },
              "maxItems": 4
            },
            "clarifying_question": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "is_answer",
            "text",
            "other_readings",
            "clarifying_question"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "architecture_version",
    "session_id",
    "state_revision",
    "reply_to_event_id",
    "message_type",
    "student_message",
    "item",
    "proposed_transition",
    "evidence_proposals",
    "resource_requests",
    "teacher_report",
    "issue",
    "reading"
  ],
  "additionalProperties": false,
  "description": "Round 6 tutor envelope (architecture 1.3): the rounds 3-5 JSON envelope, with item as a problem proposal that code verifies, proposed_transition as the tutor move, teacher_report always null, and reading for entries code asks the AI to read."
}