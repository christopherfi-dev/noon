{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Round 6 session snapshot (committed with every revision).",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "architecture_version": {
      "const": "1.7"
    },
    "curriculum_id": {
      "const": "ACE-ALGEBRA1"
    },
    "curriculum_version": {
      "const": "1.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "HOLD",
        "CLOSED"
      ]
    },
    "topic_skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "focus_skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_focus_skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "open_problem_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "open_problem_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "architecture_sha256": {
          "type": "string"
        },
        "acknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "architecture_sha256",
        "acknowledged"
      ],
      "additionalProperties": false
    },
    "goals": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "met": {
            "type": "boolean"
          },
          "pause_used": {
            "type": "boolean"
          }
        },
        "required": [
          "skill_id",
          "count",
          "met",
          "pause_used"
        ],
        "additionalProperties": false
      }
    },
    "issue": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string"
    },
    "last_activity_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "revision",
    "architecture_version",
    "curriculum_id",
    "curriculum_version",
    "status",
    "topic_skill_id",
    "focus_skill_id",
    "next_focus_skill_id",
    "open_problem_id",
    "open_problem_version",
    "pending_operation_id",
    "binding",
    "goals",
    "issue",
    "created_at",
    "last_activity_at",
    "expires_at"
  ],
  "additionalProperties": false
}