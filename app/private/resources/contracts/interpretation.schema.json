{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Round 6 (architecture 1.3) INTERPRET: the model's reading of one learner entry. Runtime contract; the host accepts a reading only after its reading checks.",
  "type": "object",
  "properties": {
    "architecture_version": {
      "const": "1.3"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "reply_to_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "operation": {
      "const": "INTERPRET"
    },
    "kind": {
      "type": "string",
      "enum": [
        "answer",
        "stuck",
        "question",
        "off_task",
        "unreadable"
      ]
    },
    "normalized_answer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "reading_note": {
      "type": "string",
      "maxLength": 300
    },
    "clarifying_question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "reply": {
      "type": "string",
      "maxLength": 1200
    }
  },
  "required": [
    "architecture_version",
    "session_id",
    "state_revision",
    "reply_to_event_id",
    "operation",
    "kind",
    "normalized_answer",
    "reading_note",
    "clarifying_question",
    "reply"
  ],
  "additionalProperties": false
}
