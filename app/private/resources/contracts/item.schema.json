{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "item_version": {
      "type": "integer",
      "minimum": 1
    },
    "curriculum_id": {
      "const": "ACE-ALGEBRA1"
    },
    "curriculum_version": {
      "const": "1.1.0"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "ORIENTATION",
        "TARGET",
        "DIAGNOSTIC",
        "PREREQUISITE",
        "GUIDED",
        "INDEPENDENT",
        "TRANSFER",
        "REVIEW"
      ]
    },
    "component_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "variant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "prompt": {
      "type": "string",
      "maxLength": 6000
    },
    "response_type": {
      "type": "string",
      "enum": [
        "scalar",
        "fraction",
        "expression",
        "equation",
        "solution_set",
        "interval",
        "ordered_list",
        "ordered_pair",
        "point_set",
        "quantity",
        "table",
        "graph_spec",
        "classification",
        "reasoning",
        "model",
        "structured_response"
      ]
    },
    "template_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "type": "object",
      "maxProperties": 20
    },
    "mathematical_objects": {
      "type": "object",
      "maxProperties": 30
    },
    "domain": {
      "type": "object",
      "properties": {
        "number_system": {
          "type": "string",
          "enum": [
            "REAL",
            "INTEGER",
            "RATIONAL",
            "COMPLEX_EXTENSION"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 100
        }
      },
      "required": [
        "number_system",
        "restrictions"
      ],
      "additionalProperties": false
    },
    "answer_spec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected": {},
        "requested_form": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "units": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 30
        }
      },
      "required": [
        "kind",
        "expected",
        "requested_form",
        "units",
        "tolerance",
        "rubric"
      ],
      "additionalProperties": false
    },
    "checking": {
      "type": "object",
      "properties": {
        "requested_route": {
          "type": "string",
          "enum": [
            "DETERMINISTIC_TEMPLATE",
            "DETERMINISTIC_SYMBOLIC",
            "TASK_SPECIFIC_GRAPH",
            "MODEL_RUBRIC_REVIEW",
            "AUTHENTICATED_HUMAN_REVIEW",
            "UNAVAILABLE"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 30
        },
        "scope": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "requested_route",
        "required_capabilities",
        "scope"
      ],
      "additionalProperties": false
    },
    "representation_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 20
    },
    "support_already_supplied": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 30
    },
    "independent_eligible_proposal": {
      "type": "boolean"
    }
  },
  "required": [
    "item_id",
    "item_version",
    "curriculum_id",
    "curriculum_version",
    "skill_id",
    "role",
    "component_id",
    "variant_id",
    "prompt",
    "response_type",
    "template_id",
    "parameters",
    "mathematical_objects",
    "domain",
    "answer_spec",
    "checking",
    "representation_requirements",
    "support_already_supplied",
    "independent_eligible_proposal"
  ],
  "additionalProperties": false
}