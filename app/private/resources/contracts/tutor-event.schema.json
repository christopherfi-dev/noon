{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Round 6 public event: one learner turn.",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 100
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "enum": [
        "SEND",
        "STUCK",
        "SKIP",
        "CHANGE_TOPIC",
        "END_SESSION",
        "RESUME"
      ]
    },
    "problem_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "problem_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "choice": {
          "type": "string",
          "enum": [
            "HINT",
            "EXPLAIN",
            "NOT_LEARNED"
          ]
        },
        "topic_skill_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "idempotency_key",
    "expected_revision",
    "action",
    "problem_id",
    "problem_version",
    "payload"
  ],
  "additionalProperties": false
}