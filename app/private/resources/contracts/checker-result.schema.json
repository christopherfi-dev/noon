{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checker_result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "checker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "checker_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "item_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "CORRECT",
        "INCORRECT",
        "PARTIAL",
        "UNSCORABLE",
        "PENDING_REVIEW",
        "VERIFICATION_CONFLICT"
      ]
    },
    "verification_scope": {
      "type": "string",
      "maxLength": 2000
    },
    "provenance": {
      "type": "string",
      "enum": [
        "DETERMINISTIC",
        "MODEL_REVIEWED",
        "AUTHENTICATED_HUMAN_REVIEWED"
      ]
    },
    "required_components_satisfied": {
      "type": "boolean"
    },
    "independent_eligible": {
      "type": "boolean"
    },
    "support_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 100
    },
    "observation": {
      "type": "string",
      "maxLength": 2000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "checker_result_id",
    "checker_id",
    "checker_version",
    "item_id",
    "item_version",
    "event_id",
    "response_sha256",
    "verdict",
    "verification_scope",
    "provenance",
    "required_components_satisfied",
    "independent_eligible",
    "support_event_ids",
    "observation",
    "limitations",
    "created_at"
  ],
  "additionalProperties": false
}