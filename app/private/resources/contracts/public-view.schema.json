{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "PENDING",
        "HOLD",
        "CLOSED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "enum": [
        "AWAITING_SESSION_CONTEXT",
        "TARGET_SELECTION",
        "STARTING_POINT_ASSESSMENT",
        "STARTING_POINT_RECOMMENDATION",
        "TARGET_ASSESSMENT",
        "DIAGNOSTIC_PROBE",
        "PREREQUISITE_CHECK",
        "GUIDED_REPAIR",
        "INDEPENDENT_CHECK",
        "RETURN_TO_TARGET",
        "TRANSFER_CHECK",
        "REVIEW_CHECK",
        "SESSION_REPORT",
        "SESSION_CLOSED"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string",
              "pattern": "^[A-Z][0-9]{2}$"
            },
            "title": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "skill_id",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "active_item": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "item_version": {
              "type": "integer",
              "minimum": 1
            },
            "prompt": {
              "type": "string",
              "maxLength": 6000
            },
            "response_type": {
              "type": "string",
              "enum": [
                "scalar",
                "fraction",
                "expression",
                "equation",
                "solution_set",
                "interval",
                "ordered_list",
                "ordered_pair",
                "point_set",
                "quantity",
                "table",
                "graph_spec",
                "classification",
                "reasoning",
                "model",
                "structured_response"
              ]
            },
            "input_help": {
              "type": "string",
              "maxLength": 2000
            },
            "support_status": {
              "type": "string",
              "enum": [
                "INDEPENDENT",
                "ASSISTED",
                "NOT_APPLICABLE"
              ]
            }
          },
          "required": [
            "item_id",
            "item_version",
            "prompt",
            "response_type",
            "input_help",
            "support_status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "INFORMATION",
              "FEEDBACK",
              "QUESTION",
              "ERROR"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 6000
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "menu": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "menu_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "option_id",
                  "label",
                  "action"
                ],
                "additionalProperties": false
              },
              "maxItems": 205
            }
          },
          "required": [
            "menu_id",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 2000
        },
        "independent_successes": {
          "type": "integer",
          "minimum": 0
        },
        "criterion_required": {
          "type": "integer",
          "minimum": 1
        },
        "whole_skill_claim": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "independent_successes",
        "criterion_required",
        "whole_skill_claim"
      ],
      "additionalProperties": false
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SELECT_TARGET",
          "SUGGEST_TARGET",
          "CONFIRM_TARGET",
          "START_ORIENTATION",
          "ACCEPT_RECOMMENDATION",
          "SUBMIT_RESPONSE",
          "REQUEST_HINT",
          "REQUEST_EXPLANATION",
          "CLARIFY_RESPONSE",
          "SKIP_ITEM",
          "NOT_LEARNED",
          "CHANGE_TARGET",
          "END_SESSION",
          "CONTINUE_SESSION",
          "RESUME_SESSION"
        ]
      },
      "maxItems": 30
    },
    "csrf_token": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "revision",
    "mode",
    "target",
    "active_item",
    "messages",
    "menu",
    "progress",
    "allowed_actions",
    "csrf_token",
    "pending_operation_id",
    "error_code"
  ],
  "additionalProperties": false
}