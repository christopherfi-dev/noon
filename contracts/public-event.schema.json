{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 100
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "enum": [
        "SELECT_TARGET",
        "SUGGEST_TARGET",
        "CONFIRM_TARGET",
        "START_ORIENTATION",
        "ACCEPT_RECOMMENDATION",
        "SUBMIT_RESPONSE",
        "REQUEST_HINT",
        "REQUEST_EXPLANATION",
        "CLARIFY_RESPONSE",
        "SKIP_ITEM",
        "NOT_LEARNED",
        "CHANGE_TARGET",
        "END_SESSION",
        "CONTINUE_SESSION",
        "RESUME_SESSION"
      ]
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "item_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "target_skill_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "working": {
          "type": "string",
          "maxLength": 4000
        },
        "suggestion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recommendation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "continue_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "idempotency_key",
    "expected_revision",
    "action",
    "item_id",
    "item_version",
    "payload"
  ],
  "additionalProperties": false
}
