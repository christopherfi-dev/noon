{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_version": {
      "const": "1.0"
    },
    "curriculum_id": {
      "const": "ACE-ALGEBRA1"
    },
    "curriculum_version": {
      "const": "1.1.0"
    },
    "target_skill_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}$"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "instructions": {
      "type": "string",
      "maxLength": 500
    },
    "maximum_minutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "task_version",
    "curriculum_id",
    "curriculum_version",
    "target_skill_id",
    "title",
    "instructions",
    "maximum_minutes",
    "issued_at",
    "expires_at"
  ],
  "additionalProperties": false
}
