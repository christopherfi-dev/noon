{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "architecture_version": {
      "const": "1.1"
    },
    "curriculum_id": {
      "const": "ACE-ALGEBRA1"
    },
    "curriculum_version": {
      "const": "1.1.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "AWAITING_SESSION_CONTEXT",
        "TARGET_SELECTION",
        "STARTING_POINT_ASSESSMENT",
        "STARTING_POINT_RECOMMENDATION",
        "TARGET_ASSESSMENT",
        "DIAGNOSTIC_PROBE",
        "PREREQUISITE_CHECK",
        "GUIDED_REPAIR",
        "INDEPENDENT_CHECK",
        "RETURN_TO_TARGET",
        "TRANSFER_CHECK",
        "REVIEW_CHECK",
        "SESSION_REPORT",
        "SESSION_CLOSED"
      ]
    },
    "entry_route": {
      "type": "string",
      "enum": [
        "TOPIC",
        "UNSURE",
        "TEACHER_TASK"
      ]
    },
    "target_episode_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "original_target_skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_item_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "active_item_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "return_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parent_skill_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "parent_mode": {
            "type": "string",
            "enum": [
              "AWAITING_SESSION_CONTEXT",
              "TARGET_SELECTION",
              "STARTING_POINT_ASSESSMENT",
              "STARTING_POINT_RECOMMENDATION",
              "TARGET_ASSESSMENT",
              "DIAGNOSTIC_PROBE",
              "PREREQUISITE_CHECK",
              "GUIDED_REPAIR",
              "INDEPENDENT_CHECK",
              "RETURN_TO_TARGET",
              "TRANSFER_CHECK",
              "REVIEW_CHECK",
              "SESSION_REPORT",
              "SESSION_CLOSED"
            ]
          },
          "edge_type": {
            "type": "string",
            "enum": [
              "all_of",
              "alternative",
              "conditional"
            ]
          },
          "edge_condition": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "trigger_event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_episode_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "parent_skill_id",
          "parent_mode",
          "edge_type",
          "edge_condition",
          "trigger_event_id",
          "target_episode_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "suspended_episode_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 50
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_episode_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "independent_correct_streak": {
            "type": "integer",
            "minimum": 0
          },
          "streak_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "covered_variant_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "immediate_status": {
            "type": "string",
            "enum": [
              "NOT_MET",
              "COMPONENT_CRITERION_MET",
              "IMMEDIATE_CRITERION_MET",
              "REVIEW_REQUIRED"
            ]
          },
          "whole_skill_requirements_satisfied": {
            "type": "boolean"
          }
        },
        "required": [
          "skill_id",
          "component_id",
          "target_episode_id",
          "independent_correct_streak",
          "streak_event_ids",
          "covered_variant_ids",
          "immediate_status",
          "whole_skill_requirements_satisfied"
        ],
        "additionalProperties": false
      },
      "maxItems": 205
    },
    "orientation": {
      "type": "object",
      "properties": {
        "presented_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "usable_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 8
        },
        "recommendation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "provisional_target_skill_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "presented_count",
        "usable_event_ids",
        "recommendation_id",
        "provisional_target_skill_id"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "target_assessment_items": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_items": {
          "type": "integer",
          "minimum": 0
        },
        "instructional_turns": {
          "type": "integer",
          "minimum": 0
        },
        "failed_repair_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        }
      },
      "required": [
        "target_assessment_items",
        "diagnostic_items",
        "instructional_turns",
        "failed_repair_cycles",
        "maximum_minutes"
      ],
      "additionalProperties": false
    },
    "pending_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "issue": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "MISSING_CURRICULUM",
                "MISSING_TARGET",
                "MISSING_STATE",
                "CURRICULUM_GAP",
                "UNSUPPORTED_RESPONSE_TYPE",
                "REPRESENTATION_UNAVAILABLE",
                "ITEM_VERIFICATION_UNAVAILABLE",
                "INVALID_ITEM",
                "VERIFICATION_CONFLICT",
                "STATE_CONFLICT",
                "EVIDENCE_PROMOTION_BLOCKED",
                "CONTRACT_CONFLICT",
                "REPAIR_LIMIT_REACHED"
              ]
            },
            "affected_scope": {
              "type": "string",
              "maxLength": 2000
            },
            "detail": {
              "type": "string",
              "maxLength": 2000
            },
            "next_action": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "affected_scope",
            "detail",
            "next_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "last_activity_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "accepted_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 2000
    },
    "binding": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "architecture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "architecture_sha256",
        "acknowledged"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "session_id",
    "revision",
    "architecture_version",
    "curriculum_id",
    "curriculum_version",
    "mode",
    "entry_route",
    "target_episode_id",
    "original_target_skill_id",
    "current_skill_id",
    "active_item_id",
    "active_item_version",
    "return_stack",
    "suspended_episode_ids",
    "criteria",
    "orientation",
    "budgets",
    "pending_operation_id",
    "issue",
    "created_at",
    "last_activity_at",
    "expires_at",
    "accepted_event_ids",
    "binding"
  ],
  "additionalProperties": false
}
